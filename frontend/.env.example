# Base URL of the backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api

# "true" uses the demo login (researcher@radiomics.local / demo1234). The backend has no login yet.
VITE_USE_MOCK_API=true

# Radiomics pipeline backend. 
VITE_BACKEND_URL=http://localhost:8000

# The XNAT folder every new upload goes into.
VITE_XNAT_PROJECT=
VITE_XNAT_SUBJECT=
VITE_XNAT_EXPERIMENT=
